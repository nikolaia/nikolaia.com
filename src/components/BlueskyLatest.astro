<ul id="bsky-latest" class="bsky-latest" hidden></ul>

<script>
  async function load() {
    const el = document.getElementById("bsky-latest");
    if (!(el instanceof HTMLUListElement)) return;

    const data = await fetch(
      "https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?actor=nikolaia.com&limit=8&filter=posts_no_replies"
    )
      .then(r => r.json())
      .catch(() => null);

    const items = data?.feed
      ?.filter((i: { reason?: unknown }) => !i.reason)
      .slice(0, 2);
    if (!items?.length) return;

    el.replaceChildren(
      ...items.map(
        (item: {
          post: {
            author: { avatar: string; displayName?: string; handle: string };
            record: { text: string };
            uri: string;
          };
        }) => {
          const { post } = item;
          const li = document.createElement("li");
          const a = document.createElement("a");
          const img = document.createElement("img");
          const p = document.createElement("p");
          img.src = post.author.avatar;
          img.alt = post.author.displayName || post.author.handle;
          img.width = 40;
          img.height = 40;
          p.textContent = post.record.text;
          a.href = `https://bsky.app/profile/${post.author.handle}/post/${post.uri.split("/").pop()}`;
          a.append(img, p);
          li.append(a);
          return li;
        }
      )
    );
    el.hidden = false;
  }

  load();
  document.addEventListener("astro:after-swap", load);
</script>

<style>
  .bsky-latest {
    @apply mt-6 flex list-none flex-col gap-4 p-0;
  }
  .bsky-latest :global(a) {
    @apply flex items-start gap-3 no-underline;
  }
  .bsky-latest :global(img) {
    @apply h-10 w-10 shrink-0 rounded-full object-cover;
  }
  .bsky-latest :global(p) {
    @apply m-0 line-clamp-4 whitespace-pre-wrap text-sm;
  }
</style>
